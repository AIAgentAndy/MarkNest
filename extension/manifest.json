{
  "manifest_version": 3,
  "name": "MarkNest",
  "short_name": "MarkNest",
  "description": "让 Markdown 文档优雅归巢，在 Chrome 中沉浸阅读本地与在线文档。",
  "version": "1.0.0",
  "action": {
    "default_title": "打开 MarkNest"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["file:///*", "http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd",
        "http://*/*",
        "https://*/*",
        "file://*/*/",
        "file:///"
      ],
      "js": ["file-url-inline-boot.js"],
      "css": ["file-url-inline-entry.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "about/*", "file-url-inline-entry.js", "file-url-inline-assets/*"],
      "matches": ["file:///*", "http://*/*", "https://*/*"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
